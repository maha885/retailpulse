# Copy this file to .env before running docker-compose up
# (docker-compose reads .env automatically — never commit the real .env to Git)

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Postgres (gold layer warehouse + Airflow metadata DB) ---
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=retailpulse
POSTGRES_DB=retailpulse
